# ============================================================
# QueryPilot — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.

# ---------- App Database ----------
# SQLite (development):
APP_DB_URL=sqlite+aiosqlite:///./querypilot.db
# PostgreSQL (production):
# APP_DB_URL=postgresql+asyncpg://user:password@localhost:5432/querypilot

# ---------- Security ----------
SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENCRYPTION_KEY=generate-with-python-c-from-cryptography.fernet-import-Fernet;print(Fernet.generate_key().decode())

# ---------- LLM Configuration ----------
# Mode: "online" (API) or "offline" (local model)
LLM_MODE=online
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=gpt-4

# ---------- Query Safety ----------
MAX_QUERY_ROWS=10000
QUERY_TIMEOUT_SECONDS=30

# ---------- Caching ----------
CACHE_TTL_SECONDS=3600

# ---------- Server ----------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
